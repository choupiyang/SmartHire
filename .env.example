# SmartHire Environment Configuration
# Version: 1.0.0
# Copy this file to .env and configure your local environment

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=SmartHire
APP_VERSION=1.0.0-alpha
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# Log Settings
# =============================================================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# Redis Configuration (IPC Bus)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=true

# Redis Pub/Sub Channels
REDIS_CHANNEL_TASKS=smarthire:tasks
REDIS_CHANNEL_EVENTS=smarthire:events
REDIS_CHANNEL_HEARTBEAT=smarthire:heartbeat

# =============================================================================
# LLM Configuration
# =============================================================================
# Default model provider: anthropic or openai
DEFAULT_MODEL_PROVIDER=anthropic

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# =============================================================================
# Database Configuration
# =============================================================================
# Evidence Database
EVIDENCE_DB_PATH=data/evidence/trace_evidence.db

# Profile Database
PROFILE_DB_PATH=data/profiles/employer_pref.db

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# Process Configuration
# =============================================================================
# Watchdog Settings
WATCHDOG_CHECK_INTERVAL=10  # seconds
WATCHDOG_HEARTBEAT_TIMEOUT=30  # seconds
WATCHDOG_MAX_RESTART_ATTEMPTS=3
WATCHDOG_RESTART_DELAY=5  # seconds

# Process Startup Buffer (COMPOUND [2026.02.25-003])
PROCESS_STARTUP_BUFFER=10  # seconds

# =============================================================================
# Windows-Specific Settings
# =============================================================================
# Path Anchoring (LAW-ENV-002: Absolute Path Ban)
PROJECT_ROOT=auto  # Auto-detect from script location

# Enable Long Paths (Windows 10+)
ENABLE_LONG_PATHS=true

# Job Objects (ENV-04: Orphan Process Leak)
USE_JOB_OBJECTS=true

# =============================================================================
# File I/O Settings
# =============================================================================
# Atomic Write Protocol (LAW-DATA-002)
USE_ATOMIC_WRITE=true
WRITE_TEMP_SUFFIX=.tmp
WRITE_SYNC_MODE=true  # fsync after write

# Encoding (ENV-03: GBK Zombie Output)
DEFAULT_ENCODING=utf-8
FALLBACK_ENCODING=gbk

# =============================================================================
# Compliance & Safety
# =============================================================================
# Compliance Checker (PLAN Process)
ENABLE_COMPLIANCE_CHECKER=true
COMPLIANCE_REGION_BLACKLIST=  # Comma-separated banned regions
COMPLIANCE_DISCRIMINATION_KEYWORDS=  # Comma-separated banned keywords

# Data Sovereignty (LAW-DEF-002)
ENABLE_AUTO_BACKUP=true
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Testing Settings
# =============================================================================
# Test Mode
TEST_MODE=false
TEST_DATA_DIR=tests/fixtures
TEST_LOG_LEVEL=DEBUG

# Chaos Testing (DIAGNOSIS §2.2)
ENABLE_CHAOS_TESTING=false
CHAOS_TEST_ROUNDS=100
CHAOS_FAILURE_RATE=0.1

# =============================================================================
# Performance Settings
# =============================================================================
# IPC Bus Performance (COMPOUND IPC-02)
MESSAGE_QUEUE_MAX_LENGTH=1000
MESSAGE_BACKPRESSURE_THRESHOLD=800

# LLM Client Cache (COMPOUND L3-01)
ENABLE_LLM_CLIENT_CACHE=true
LLM_CLIENT_CACHE_TTL=3600  # seconds

# Sequence ID (COMPOUND IPC-01)
SEQUENCE_ID_REDIS_KEY=smarthire:sequence_id

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Tracing
ENABLE_TRACING=true
TRACE_ID_HEADER=X-Trace-ID

# =============================================================================
# Security Settings
# =============================================================================
# Single-Tenant (LAW-TENANT-001)
ENABLE_AUTH=false  # Always false for single-tenant
ENABLE_RBAC=false  # Always false for single-tenant

# API Security
API_KEY_HEADER=X-API-Key
API_KEY=  # Optional: Set if using external API

# =============================================================================
# Feature Flags
# =============================================================================
# Experimental Features
ENABLE_EXPERIMENTAL_SKILLS=false
ENABLE_SHADOW_MODE=false  # DIAGNOSIS §4.2 Shadow Evolution

# SOP Auto-Evolution (MAP §2 Phase 3)
ENABLE_SOP_EVOLUTION=false

# =============================================================================
# Developer Settings
# =============================================================================
# Auto-Reload (Development Only)
ENABLE_AUTO_RELOAD=true

# Code Sync (LAW-ENG-003)
GIT_REMOTE_URL=https://github.com/choupiyang/shasha.git
GIT_AUTO_SYNC_ENABLED=false
GIT_AUTO_SYNC_INTERVAL=3600  # seconds

# =============================================================================
# Documentation
# =============================================================================
# For more information, see:
# - Architecture: ARCH.md
# - Development Rules: LAW.md
# - Testing Protocol: DIAGNOSIS.md
# - Task Strategy: MAP.md
# - Known Issues: COMPOUND.md
# =============================================================================
